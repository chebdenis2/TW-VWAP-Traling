//@version=6
strategy("VCS 2 with VWAP Levels (Parity)", overlay=true, calc_on_every_tick=true, process_orders_on_close=false)

//========================
// Inputs
//========================
hideonDWM = input.bool(false, "Hide VWAP on 1D or Above", group="VWAP Settings")

anchor = input.string(
     defval="Week",
     title="Anchor Period",
     options=[
         "Session", "Hour", "2 Hours", "4 Hours", "8 Hours", "12 Hours",
         "Week", "Month", "Quarter", "Year", "Decade", "Century",
         "Earnings", "Dividends", "Splits"
     ],
     group="VWAP Settings"
)

src    = input.source(hlc3, "Source", group="VWAP Settings")
offset = input.int(0, "Offset", group="VWAP Settings", minval=0)

trade_mode = input.string("VWAP (Limit)", "Strategy", options=["VWAP (Limit)", "Anchor Open (Market)"], group="Strategy")
direction = input.string("LONG", "Direction", options=["LONG", "SHORT", "BOTH"], group="Strategy")
vwap_both_min_delta_pct = input.float(0.1, "BOTH min delta (%)", step=0.1, group="Strategy")
vwap_both_start_direction = input.string("NONE", "BOTH start direction", options=["NONE", "LONG", "SHORT"], group="Strategy")

entry_distance_long_pct  = input.float(1.0, "Entry Long (%)", step=0.1, group="VWAP Levels")
entry_distance_short_pct = input.float(1.5, "Entry Short (%)", step=0.1, group="VWAP Levels")
tp_pct = input.float(1.5, "TP (%)", step=0.1, group="VWAP Levels")
sl_pct = input.float(4.0, "SL (%)", step=0.1, group="VWAP Levels")
entry_qty = input.float(0.001, "Entry quantity", step=0.001, group="VWAP Levels")

anchor_open_min_delta_pct = input.float(0.0, "Min delta open vs prev VWAP (%)", step=0.1, minval=0.0, group="Anchor Open")
anchor_open_sl_pct_of_tp  = input.float(100.0, "SL (% of TP size)", step=1.0, minval=0.0, group="Anchor Open")
anchor_open_close_on_anchor_end = input.bool(true, "Close on anchor end", group="Anchor Open")
anchor_use_sessions = input.bool(false, "Use sessions for entry", group="Anchor Open")

trailing_stop_enabled = input.bool(false, "Enable trailing stop", group="Trailing Stop")
trailing_candle_filter = input.string("all", "Candle filter", options=["all", "opposite"], group="Trailing Stop")
refresh_tf = input.timeframe("60", "Candle timeframe", group="Trailing Stop")

pause_on_sl = input.bool(false, "Pause after SL (legacy)", group="Pause")
pause_after_sl_minutes = input.int(0, "Pause minutes after SL", minval=0, group="Pause")

use_date_filter = input.bool(false, "Use date filter", group="Date Range")
start_year  = input.int(2025, "Год начала", group="Date Range")
start_month = input.int(1, "Месяц начала", minval=1, maxval=12, group="Date Range")
end_year    = input.int(2025, "Год окончания", group="Date Range")
end_month   = input.int(12, "Месяц окончания", minval=1, maxval=12, group="Date Range")

session_asia_enabled    = input.bool(true, "Азия", group="Sessions")
session_europe_enabled  = input.bool(true, "Европа", group="Sessions")
session_america_enabled = input.bool(true, "Америка", group="Sessions")

force_close_end_period  = input.bool(false, "Close all at anchor end", group="Force Close")
force_close_end_session = input.bool(false, "Close all at session end", group="Force Close")

//========================
// Date range
//========================
start_date = timestamp(start_year, start_month, 1, 0, 0)

end_month_next = end_month == 12 ? 1 : (end_month + 1)
end_year_next  = end_month == 12 ? (end_year + 1) : end_year
end_date       = timestamp(end_year_next, end_month_next, 1, 0, 0) - 1

in_date_range = not use_date_filter or (time >= start_date and time <= end_date)
exited_date_range = not in_date_range and in_date_range[1]

//========================
// Sessions filter (for entries only)
//========================
inSession(sess) => not na(time(timeframe.period, sess))

in_asia    = inSession("0000-0800")
in_europe  = inSession("0800-1600")
in_america = inSession("1600-2359")

can_open_by_session =
     (session_asia_enabled and in_asia) or
     (session_europe_enabled and in_europe) or
     (session_america_enabled and in_america)

//========================
// VWAP (anchored)
//========================
cumVolume = ta.cum(volume)
if barstate.islast and cumVolume == 0
    runtime.error("No volume is provided by the data vendor.")

new_earnings  = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
new_dividends = request.dividends(syminfo.tickerid, dividends.gross, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)
new_split     = request.splits(syminfo.tickerid, splits.denominator, barmerge.gaps_on, barmerge.lookahead_on, ignore_invalid_symbol=true)

isNewPeriod = switch anchor
    "Earnings"  => not na(new_earnings)
    "Dividends" => not na(new_dividends)
    "Splits"    => not na(new_split)
    "Session"   => timeframe.change("D")
    "Hour"      => timeframe.change("60")
    "2 Hours"   => timeframe.change("120")
    "4 Hours"   => timeframe.change("240")
    "8 Hours"   => timeframe.change("480")
    "12 Hours"  => timeframe.change("720")
    "Week"      => timeframe.change("W")
    "Month"     => timeframe.change("M")
    "Quarter"   => timeframe.change("3M")
    "Year"      => timeframe.change("12M")
    "Decade"    => timeframe.change("12M") and year % 10 == 0
    "Century"   => timeframe.change("12M") and year % 100 == 0
    => false

isEsdAnchor = anchor == "Earnings" or anchor == "Dividends" or anchor == "Splits"
if na(src[1]) and not isEsdAnchor
    isNewPeriod := true

float vwap_value = na
if not (hideonDWM and timeframe.isdwm)
    [_vwap, _, _] = ta.vwap(src, isNewPeriod, 1)
    vwap_value := _vwap

//========================
// Time helpers
//========================
is_new_candle = ta.change(time(refresh_tf)) != 0
htf_open = request.security(syminfo.tickerid, refresh_tf, open, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htf_close = request.security(syminfo.tickerid, refresh_tf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
prev_o = htf_open[1]
prev_c = htf_close[1]

//========================
// Helpers
//========================
round_down(x) =>
    t = syminfo.mintick
    t > 0 ? math.floor(x / t) * t : x

tighten_sl(cur, desired, dir) =>
    if na(cur)
        desired
    else
        dir == "LONG" ? math.max(cur, desired) : math.min(cur, desired)

trail_candidate(dir, cur_sl) =>
    if not trailing_stop_enabled or na(cur_sl) or na(prev_o) or na(prev_c)
        na
    body = math.abs(prev_c - prev_o)
    if body <= 0
        na
    if trailing_candle_filter == "all"
        dir == "LONG" ? cur_sl + body : cur_sl - body
    else
        if dir == "LONG" and prev_c < prev_o
            cur_sl + (prev_o - prev_c)
        else if dir == "SHORT" and prev_c > prev_o
            cur_sl - (prev_c - prev_o)
        else
            na

//========================
// State
//========================
var float anchor_last_vwap = na
var float prev_anchor_vwap = na
var float anchor_open_price = na
var float vwap_anchor_open_price = na
var bool anchor_decided = false
var bool vwap_anchor_decided = false
var string vwap_anchor_direction = ""

var float vwap_tp_price = na
var float vwap_sl_price = na
var float anchor_tp_price = na
var float anchor_sl_price = na

var int pause_until = na

// Anchor rollover
if isNewPeriod
    if not na(anchor_last_vwap)
        prev_anchor_vwap := anchor_last_vwap
    anchor_last_vwap := na
    anchor_open_price := open
    vwap_anchor_open_price := open
    anchor_decided := false
    vwap_anchor_decided := false
    vwap_anchor_direction := ""

if not na(vwap_value)
    anchor_last_vwap := vwap_value

//========================
// Levels
//========================
long_entry  = round_down(vwap_value * (1 - entry_distance_long_pct / 100))
short_entry = round_down(vwap_value * (1 + entry_distance_short_pct / 100))
long_tp     = round_down(vwap_value * (1 + tp_pct / 100))
long_sl     = round_down(vwap_value * (1 - sl_pct / 100))
short_tp    = round_down(vwap_value * (1 - tp_pct / 100))
short_sl    = round_down(vwap_value * (1 + sl_pct / 100))

//========================
// Position state
//========================
inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0

//========================
// Pause after SL
//========================
pause_minutes = pause_after_sl_minutes > 0 ? pause_after_sl_minutes : (pause_on_sl ? 60 : 0)
if not na(pause_until) and time >= pause_until
    pause_until := na
paused = not na(pause_until) and time < pause_until

// Detect SL exit (use previous stored SL)
new_closed = strategy.closedtrades > strategy.closedtrades[1]
if new_closed and pause_minutes > 0
    last = strategy.closedtrades - 1
    xid = strategy.closedtrades.exit_id(last)
    xpr = strategy.closedtrades.exit_price(last)
    tol = syminfo.mintick * 2
    is_stop = false
    if (xid == "VWAP Exit L" or xid == "VWAP Exit S") and not na(vwap_sl_price)
        is_stop := math.abs(xpr - vwap_sl_price) <= tol
    if (xid == "Anchor Exit L" or xid == "Anchor Exit S") and not na(anchor_sl_price)
        is_stop := math.abs(xpr - anchor_sl_price) <= tol
    if is_stop
        pause_until := time + pause_minutes * 60 * 1000

//========================
// Force close
//========================
is_anchor_mode = trade_mode == "Anchor Open (Market)"
is_vwap_mode = not is_anchor_mode

if is_anchor_mode
    if anchor_open_close_on_anchor_end and isNewPeriod and (inLong or inShort)
        strategy.close_all(comment="Anchor end")
else
    if force_close_end_period and isNewPeriod and (inLong or inShort)
        strategy.close_all(comment="End of anchor")

if force_close_end_period and exited_date_range
    strategy.close_all(comment="End of date range")

end_asia    = session_asia_enabled and in_asia[1] and not in_asia
end_europe  = session_europe_enabled and in_europe[1] and not in_europe
end_america = session_america_enabled and in_america[1] and not in_america

if force_close_end_session and (end_asia or end_europe or end_america)
    strategy.close_all(comment="End of session")

//========================
// VWAP BOTH auto-direction
//========================
dir_input = str.upper(direction)
trade_dir = dir_input
start_dir = str.upper(vwap_both_start_direction)

if is_vwap_mode and dir_input == "BOTH"
    if inLong
        trade_dir := "LONG"
    else if inShort
        trade_dir := "SHORT"
    else
        if not vwap_anchor_decided
            if not na(prev_anchor_vwap) and prev_anchor_vwap != 0 and not na(vwap_anchor_open_price)
                delta_pct = math.abs(vwap_anchor_open_price - prev_anchor_vwap) / prev_anchor_vwap * 100
                if delta_pct >= vwap_both_min_delta_pct
                    vwap_anchor_direction := vwap_anchor_open_price > prev_anchor_vwap ? "SHORT" : "LONG"
                else
                    vwap_anchor_direction := ""
                vwap_anchor_decided := true
            else
                if na(prev_anchor_vwap) and (start_dir == "LONG" or start_dir == "SHORT")
                    vwap_anchor_direction := start_dir
                    vwap_anchor_decided := true
        trade_dir := vwap_anchor_direction

//========================
// Anchor Open strategy (market)
//========================
if is_anchor_mode
    // Ensure VWAP limit orders are not active in anchor mode
    strategy.cancel("VWAP Long")
    strategy.cancel("VWAP Short")

    can_open_anchor = in_date_range and (not anchor_use_sessions or can_open_by_session) and not paused
    if not inLong and not inShort and not anchor_decided and can_open_anchor
        if not na(prev_anchor_vwap) and prev_anchor_vwap != 0 and not na(anchor_open_price)
            delta_pct = math.abs(anchor_open_price - prev_anchor_vwap) / prev_anchor_vwap * 100
            if delta_pct >= anchor_open_min_delta_pct and anchor_open_price != prev_anchor_vwap
                dir = anchor_open_price > prev_anchor_vwap ? "SHORT" : "LONG"
                if dir == "LONG"
                    strategy.entry("Anchor Long", strategy.long, qty=entry_qty)
                else
                    strategy.entry("Anchor Short", strategy.short, qty=entry_qty)
                tp_dist = math.abs(anchor_open_price - prev_anchor_vwap)
                sl_dist = tp_dist * (anchor_open_sl_pct_of_tp / 100)
                anchor_tp_price := round_down(prev_anchor_vwap)
                anchor_sl_price := round_down(dir == "LONG" ? anchor_open_price - sl_dist : anchor_open_price + sl_dist)
            anchor_decided := true

    if (inLong or inShort) and not na(anchor_tp_price) and not na(anchor_sl_price)
        dir = inLong ? "LONG" : "SHORT"
        if trailing_stop_enabled and is_new_candle
            trail = trail_candidate(dir, anchor_sl_price)
            if not na(trail)
                anchor_sl_price := tighten_sl(anchor_sl_price, round_down(trail), dir)
        if inLong
            strategy.exit("Anchor Exit L", from_entry="Anchor Long", limit=anchor_tp_price, stop=anchor_sl_price)
        if inShort
            strategy.exit("Anchor Exit S", from_entry="Anchor Short", limit=anchor_tp_price, stop=anchor_sl_price)

//========================
// VWAP strategy (limit)
//========================
if is_vwap_mode
    can_open_vwap = in_date_range and can_open_by_session and not paused and not na(vwap_value)
    if not inLong and not inShort
        if is_new_candle or not can_open_vwap or trade_dir == ""
            strategy.cancel("VWAP Long")
            strategy.cancel("VWAP Short")
        if can_open_vwap and trade_dir == "LONG"
            strategy.entry("VWAP Long", strategy.long, qty=entry_qty, limit=long_entry)
        if can_open_vwap and trade_dir == "SHORT"
            strategy.entry("VWAP Short", strategy.short, qty=entry_qty, limit=short_entry)
    else
        dir = inLong ? "LONG" : "SHORT"
        desired_tp = dir == "LONG" ? long_tp : short_tp
        desired_sl = dir == "LONG" ? long_sl : short_sl
        if not na(vwap_value)
            if na(vwap_tp_price) or is_new_candle
                vwap_tp_price := desired_tp
            if na(vwap_sl_price) or is_new_candle
                vwap_sl_price := tighten_sl(vwap_sl_price, desired_sl, dir)
                if trailing_stop_enabled and is_new_candle
                    trail = trail_candidate(dir, vwap_sl_price)
                    if not na(trail)
                        vwap_sl_price := tighten_sl(vwap_sl_price, round_down(trail), dir)
        if not na(vwap_tp_price) and not na(vwap_sl_price)
            if inLong
                strategy.exit("VWAP Exit L", from_entry="VWAP Long", limit=vwap_tp_price, stop=vwap_sl_price)
            if inShort
                strategy.exit("VWAP Exit S", from_entry="VWAP Short", limit=vwap_tp_price, stop=vwap_sl_price)

// Reset exit tracking after close
just_closed = strategy.position_size == 0 and strategy.position_size[1] != 0
if just_closed
    vwap_tp_price := na
    vwap_sl_price := na
    anchor_tp_price := na
    anchor_sl_price := na

//========================
// Plots
//========================
plot(vwap_value, title="VWAP", color=color.blue, linewidth=2, offset=offset)
plot(is_vwap_mode ? long_entry : na, title="Long Entry", color=color.green, linewidth=1, style=plot.style_circles, offset=offset)
plot(is_vwap_mode ? short_entry : na, title="Short Entry", color=color.red, linewidth=1, style=plot.style_circles, offset=offset)
plot(is_vwap_mode ? long_sl : na, title="SL Long", color=color.orange, linewidth=1, style=plot.style_circles, offset=offset)
plot(is_vwap_mode ? short_sl : na, title="SL Short", color=color.orange, linewidth=1, style=plot.style_circles, offset=offset)
plot(is_anchor_mode ? prev_anchor_vwap : na, title="Anchor TP (prev anchor VWAP)", color=color.purple, linewidth=2, style=plot.style_linebr, offset=offset)
